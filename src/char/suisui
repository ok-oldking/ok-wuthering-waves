import time

from src.Labels import Labels
from src.char.BaseChar import BaseChar, Elements, SwitchPriority


class Suisui(BaseChar):
    """穗穗 自动战斗: 效应体系专辅, 本体几乎无伤害, 全部价值压在「延奏」那一下。

    机制(决定了下面所有写法):
      浣尘时(初始态): 普攻/E突进/成功闪避 攒【水云息】(上限120)。满了 E 变「醒春潮」,
        放出后进入濯雨时。变奏技能(入场)同样消耗全部水云息, 直接进濯雨时。
      濯雨时: 只有 15 秒, 且是游戏侧的真实时间(不受动画冻结影响)。
        普攻/重击/E 攒【芳菲信】(上限600), E 一次回 100 是最快的一档。
        普攻第3段牵引聚怪, 第4段附加【霜渐效应】。
        退出濯雨时(时间到 或 延奏离场)会清空芳菲信 —— 这是整套代码最硬的约束。
      共鸣解放「山河水境」: 30 秒领域, 效应层数上限+3。
      延奏「淥水盈盈」: 消耗芳菲信, 200/400/600 三档。600 档才给下一个角色 50% 攻击,
        400 档才有 12% 伤害提升, 底档只剩 25% 全伤加深 + 抗打断。

    站场分两条轴, 只有开头不同, 从"等第一格回路能量满"起完全一样:

      启动轴(开场, 手上什么都没有):
        按住攻击键 → 等E亮(水云息满) → 按E「醒春潮」进濯雨时 → ↓
      循环轴(绯雪大招后变奏入场, 变奏技能本身已经把她推进濯雨时):
        按住攻击键 → ↓

      ↓ 共同段(攻击键全程按住不松):
        等第一格回路能量满 → 按E落地 → 等 0.95 秒
        → 切绯雪入场, 到位后立刻狂点穗穗把场子要回来
        → 回到穗穗: Q → 【保底: 三格回路能量满才准放R】→ R「山河水境」
        → 切洛瑟菈

    攻击键是鼠标、E/Q/数字键是键盘, 互不冲突, 所以整条轴中途一次都不用松手,
    只在放 R 之前松开。切人期间也保持按住 —— 点击落在谁身上就由谁打出来。

    大招压到最后放: 30 秒领域几乎全部覆盖洛瑟菈/绯雪的输出窗口, 而不是在穗穗自己
    站场时先烧掉 7~8 秒; 同时放招那一刻领域已存在, 紧接着的延奏照样进仙游碧落。

    队伍轴(穗穗 → 洛瑟菈 → 绯雪, 约 25 秒一圈), 顺序靠 get_switch_priority 钉死。
    """

    # ---- 濯雨时相关: 这段用墙钟时间, 因为 15 秒是游戏侧计时, 动画冻结时它照样在走 ----
    MISTY_WINDOW: float = 15.0  # 濯雨时总时长
    LIB_CAST_RESERVE: float = 3.0  # 窗口末尾预留给"放大招 + 切人"的时间

    # ---- 行为预算: 这些用 time_elapsed_accounting_for_freeze, 是脚本自己的耐心 ----
    ATTACK_CHAIN_TIME: float = 1.3  # 一轮普攻连段时长, 够走完 4 段
    CON_TOP_UP_CHAIN: float = 0.4  # 芳菲信已满、只差协奏时的普攻粒度
    ATTACK_INTERVAL: float = 0.2  # 普攻点击间隔, 别刷太快(高频点击有掉线检测风险)
    ENTER_MISTY_TIMEOUT: float = 6.0  # 浣尘时攒满水云息进濯雨时的最长尝试时间
    # 开始补协奏之前, 先给能量环留多久渲染时间 (秒)。
    # R 放完时协奏往往已经满了, 但读数滞后 —— 立刻去读会读到 0, 白打一两下才发现早满了
    CON_SETTLE_WAIT: float = 0.8
    CON_SETTLE_POLL: float = 0.1
    # 交接时等协奏读数稳定的上限 (秒)。读数滞后会让 has_intro 误判成 False,
    # 下一个角色就拿不到变奏了
    HANDOFF_CON_WAIT: float = 0.8
    HANDOFF_CON_POLL: float = 0.1
    # True: 大招之后用数字键直接切人, 不走 switch_next_char()。
    # 框架那个函数内部自带 continues_normal_attack / click, 哪怕跳过了补协奏,
    # 它自己还是会点出一下A。直接按数字键就没有这些
    DIRECT_SWITCH_AFTER_LIB: bool = True
    # 大招后交棒给谁: 优先按角色名找(不假设队伍顺序), 名字找不到才退回这个槽位 (1-based)
    SWITCH_TARGET_NAME: str = 'char_lucilla'
    DIRECT_SWITCH_INDEX: int = 2
    QUICK_PASS_TIMEOUT: float = 4.0  # 大招没好时的过场模式: 协奏满就走
    LIB_CD_TOLERANCE: float = 1.5  # 大招 CD 小于这个值就当它好了, 值得走完整套
    FORTE3_THRESHOLD: float = 0.75  # 芳菲信满档的识别阈值, 原来 0.6 太松会误判
    FORTE3_CONFIRM: int = 2  # 连续命中这么多次才认, 单帧误判不算
    MIN_MISTY_BEFORE_LIB: float = 3.0  # 进濯雨时不足这个秒数时不认满档 —— 物理上不可能满
    FIELD_ACTIVE_TIME: float = 26.0  # 山河水境 30 秒, 留 4 秒余量算"还在"
    # 上一次延奏后多久内不让别人把她切回来。取自上游实测值:
    # 25 秒轴下队里有主C时 24 秒, 没主C时 26 秒(她自己要占更多站场)
    MAIN_DPS_OUTRO_LOCKOUT: float = 24.0
    OUTRO_LOCKOUT: float = 26.0

    # ---- 主轴: 长按流程 ----
    OPENING_HOLD: bool = True  # 关掉就退回"攒水云息进濯雨时"的老路
    OPEN_E_WAIT_TIMEOUT: float = 10.0  # 启动轴按住等 E 图标亮的上限 (秒)
    OPEN_POLL: float = 0.1  # 按住期间的轮询间隔 (秒)
    # 醒春潮之后隔多久开始按落地E (秒) —— 这条轴唯一的"什么时候按E"的旋钮。
    #
    # 这一格没有可用的识别图(素材里只有 suisui_forte2 / suisui_forte3, 第一格没标注),
    # 所以只能按时间走。醒春潮把她顶上天, E 只在上升/滞空那段有效, 一旦进入下落过程
    # 按 E 就没反应。
    #
    # 实战标定记录:
    #   3.0 / 3.1       → 已经落在下落段, E 完全不出
    #   2.0 / 2.2 / 2.4 → E 能出来, 但偏早
    #   2.8             → 当前值
    # 有效窗口夹在 2.4 和 3.0 之间, 而且很窄 —— 往上调要小步, 一旦越过就是完全不出,
    # 不是"稍微晚一点"
    FIRST_BAR_TIME: float = 2.8
    # 循环轴(变奏入场)按落地E的时机 (秒)。
    # 【计时起点和启动轴不同】: 启动轴从醒春潮放出算起, 这里从她被切上场那一刻算起 ——
    # 中间没有醒春潮, 而且开头约 0.9 秒是变奏入场动画。所以两个值没有可比性,
    # 不要因为启动轴调到 2.8 就跟着改这个。
    #
    # 实战标定记录:
    #   3.1 / 2.9 / 2.7 → 已在下落段, E 完全没反应
    #   2.6             → 能出, 但只比失败区低 0.1 秒, 偶尔还是晚
    # 【基准是"头像确认切人"那一刻】(switch_in_anchor), 不是 do_perform 被调用那一刻。
    #
    # 以 do_perform 为基准时的标定 —— 注意那时候结论互相打架, 因为基准本身在飘:
    #   2.6 / 2.4 / 2.2 → 晚 (2.2 甚至"没按上")
    #   2.1 / 2.0       → 早
    # 差 0.1 秒结论就相反, 说明有效窗口只有零点几秒宽, 而抖动跨过了它。
    #
    # 换成锚点之后, 实测那段延迟是 0.04~0.12 秒(跨度 0.08 秒, 正好够毁掉这么窄的窗口),
    # 而且症状从"有时早有时晚"变成了"一致地偏早" —— 方差没了, 剩下的只是固定偏移量。
    # 锚点稳定之后这就是个常数偏移了, 逐档往后挪:
    # 2.25 / 2.35 / 2.4 / 2.45 / 2.5 都还偏早 → 2.6。
    # (判断偏早还有个客观旁证: forte3 full after 越大说明第一格攒得越少 = E 按早了。
    #  实测偏早那轮 4.7 秒, 时机合适那轮 2.0 秒)
    # 往后挪要小步 —— 早了只是第一格没攒满(wait_forte3 兜得住), 晚了是整轮报废
    # (E 没生效 → 人还在空中 → 切绯雪超时 2 秒, 日志 failed to switch to dps)。
    #
    # 已排除的锚点: box_highlighted('resonance') —— 每轮都在 0.01 秒就为真,
    # 入场动画期间技能栏根本没被盖住, 抓不到事件
    # 晚了的连锁反应很贵: 一直按着攻击键, 一个空中重击打完她就自己开始下落, 而下落中
    # 按 E 没反应 → 人还在空中 → 紧接着的切绯雪整整超时 2 秒(日志 failed to switch to
    # dps) → 整轮废掉。早了的代价只是第一格没攒满, 而那个有 wait_forte3 兜着。
    # 两边不对称, 所以往早的一侧靠
    FIRST_BAR_TIME_INTRO: float = 2.6
    # 循环轴补发第二次 E 的间隔 (秒), 0 = 不补发。
    # 试过 0.25: 不解决问题, 而且坐实了那个风险 —— 地面那发 E 会把她重新顶上天,
    # 于是切绯雪时人还在空中。所以关掉
    E_LAND_SECOND: float = 0.0
    # 用【头像认出切人完成的那一刻】当循环轴的计时锚点, 而不是"do_perform 被调用的那一刻"。
    #
    # 这两者之间隔着: 框架的交接记账、绯雪 leave() 的返回、任务循环再调到穗穗 ——
    # 这段是变长的, 也正是一直在飘、我们又看不见的那部分。用 last_switch_in_time
    # (交接时 handoff_to 写的, 就是 in_team() 从头像上确认切换完成的时刻)当基准, 就把它锁住了。
    #
    # 锚点可信的上限 (秒): gap 超过它就不信这个时间戳, 退回用当前时刻。
    #
    # gap 实测是【双峰】的: 0.04~0.12 一簇, 0.74~0.98 一簇 —— 走了两条不同的交接路径
    # (绯雪 leave() 先试 direct_switch, 失败才回退到框架的 switch_next_char)。
    #
    # 【试过把上限压到 0.35 去掐掉大的那一簇, 结果证明方向错了】: 被拒绝的那轮 E 明显偏晚
    # (forte3 要等 2.0 秒), 而正常锚定的那轮偏早(forte3 等 4.7 秒)。也就是说 gap=0.75 时
    # 真正的入场确实早了 0.75 秒, 锚点是对的 —— 拒掉它等于让 E 晚发 0.75 秒。
    # 所以这个上限只保留"防时间戳过期"的本职, 给得宽一点, 两簇都收
    SWITCH_ANCHOR_MAX: float = 1.5
    # 按E落地之后到开始切绯雪的间隔 (秒)。
    # 这个值要够长按攻击键真的【A出去一段】再切 —— 切走时连段已经起来了, 切回来才会
    # 接着往下打, 而不是从第一段重新开始。给短了就是白跑一趟, 回来还得重新起手
    E_LAND_TO_SWITCH: float = 0.95
    # 从绯雪切回穗穗、按完Q之后, 隔多久开R (秒)。
    # 保底那道闸(wait_forte3)排在这后面 —— 三格已经满时它一帧就过, 不会额外拖时间;
    # 没满才会真的等, 那是保底该做的事
    BACK_TO_R: float = 0.1
    # 【别再拿 get_cd('resonance') 去验穗穗的E有没有放出来】: 实测醒春潮(确定成功, 因为
    # 濯雨时开了、芳菲信攒到了600)读出来也是 -0.0s。她的E读不到CD, 这个判据对她无效。
    # 之前基于它做的"补发/等CD/发E前松攻击键"全部拆掉了, 恢复成一次干净的点按。
    # 要验落地E, 只能看画面, 或者换个信号(比如芳菲信涨没涨、suisui_e1 图标)
    # 放完大招到读协奏之间的缓冲 (秒)。大招动画刚结束时能量环还没渲染回来,
    # 立刻切人会把协奏读成 0 —— 那一轮延奏就没了, 后面洛瑟菈、绯雪跟着都没有变奏
    POST_LIB_SETTLE: float = 0.15

    # ---- 借主C一下: 切绯雪入场, 到位立刻把场子要回来 ----
    # 切人就是按数字键(index+1), 框架自己也是循环重发直到检测到切换成功, 所以手动做一个
    # 来回可行。但框架的 current_char 状态不跟着变 —— 全程它以为穗穗还在场, 所以必须自己
    # 确认 index 归位; 任何一步没切成就当没发生过, 交给后面的正常流程兜底。
    DPS_TOUCH: bool = True
    # 单程切人的最长尝试时间 (秒)。回程给得比去程宽: 刚切过去马上要切回来, 可能撞上
    # 游戏那边的切人硬直, 得一直重发键等它放行 —— 这就是"一直快速尝试切穗穗"
    DPS_TOUCH_OUT_TIMEOUT: float = 2.0
    DPS_TOUCH_BACK_TIMEOUT: float = 3.0
    # 切人时【重发】数字键的间隔 (秒)。两头都有坑, 得夹在中间:
    #   太小(0.12) → 切换生效到 in_team() 读出来之间有两三帧延迟, 这段时间多发的键会
    #                排队, 等切回穗穗之后再触发一次, 表现是"绯雪在错误的节点又切进来"
    #   太大(0.35) → 第一次按键没生效时要多等 0.35 秒才补发, 切人落点整体后移还变飘。
    #                实测 dps touch 的来回从 1.2~1.3 秒涨到 1.4~1.5 秒
    SWITCH_KEY_RESEND: float = 0.22
    # 回程(切回穗穗)的重发间隔 (秒)。
    #
    # 【别再加密】: 试过 0.08 —— 回程确实快了 0.1 秒(1.23 → 1.14), 但启动轴的
    # forte3 从 0.4 秒退化到 1.9 秒, 净亏。原因是 PostMessage 的 send_key() 每次都会
    # 调 try_activate() 投一条 WM_ACTIVATE, 而窗口一收到它, 游戏很可能把输入状态重置,
    # 按住的左键就松了 —— 发键越密, 攻击被打断得越厉害。
    # 回程那 1.2 秒基本是游戏的切人CD, 本来就省不掉, 不值得拿输出去换
    SWITCH_KEY_RESEND_BACK: float = 0.22
    SWITCH_POLL: float = 0.05  # 查 in_team 的间隔 (秒), 要比重发密, 好尽快发现切成了

    # ---- 保底: 三格回路能量 ----
    # 延奏只有 600(三格)档才给下一个角色 50% 攻击, 400 档只有 12% 伤害提升 ——
    # 这一格就是穗穗整套的全部价值, 所以宁可多站一会儿也不空着手放 R
    FORTE3_WAIT: float = 8.0  # 等三格满的上限 (秒), 超了就照放不误
    FORTE3_POLL: float = 0.1
    # 穗穗不按处决: 处决带全局时停, 会把她按秒排好的长按流程整段推歪。
    # 全队的 F 归绯雪, 由她在自己轴上那个固定点按 (她是 Healer, 框架的切人自动按F
    # 本来就不会落到她头上)
    USE_F_BREAK: bool = False

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.last_outro = -1  # 上一次协奏满离场(真的放出延奏)的时间
        self.last_field = -1  # 上一次铺出山河水境的时间
        self.misty_start = -1  # 本次进入濯雨时的墙钟时间
        self._forte3_hits = 0  # 芳菲信满档连续命中计数
        # 别人用 handoff_to() 直接切给我时打的标记。
        # 不能只靠 has_intro —— reset_state() 每次重读队伍都会把它清成 False,
        # 而战斗判定一抖动就会重进战斗、重读队伍, 于是穗穗以为自己空手入场,
        # 跑去走开场那套"按住攻击键"的流程(表现就是切过去一直在蓄力重击)
        self.intro_pending = False
        if self.ring_index < 0:
            # CharFactory 里穗穗没写 ring_index, 协奏值环颜色会被现场猜;
            # 万一第一次判定发生在濯雨时特效糊住能量环时会锁死错值,
            # 而离场判定完全依赖 is_con_full(), 所以这里直接钉成冷凝。
            self.ring_index = Elements.ICE

    # ------------------------------------------------------------------ 主流程

    def do_perform(self):
        if self.flying():
            self.wait_down()

        if self.has_intro or self.intro_pending:
            # 变奏技能·泠泠漱玉声 已经消耗水云息把她推进濯雨时了, 不用再攒
            self.logger.info('suisui intro, already in misty')
            self.intro_pending = False
            self.enter_misty_state()
            return self.hold_axis(opening=False)

        self.intro_pending = False

        if self.in_misty():
            # 上一轮被中途切走(补奶/换目标等)但濯雨时还在走: 第一格早就满了, 直接接后半段
            self.logger.info(f'suisui resuming misty, {self.misty_left():.1f}s left')
            return self.hold_axis(opening=False, skip_first_bar=True)

        if self.OPENING_HOLD:
            return self.hold_axis(opening=True)

        if self.worth_full_rotation():
            self.enter_misty()
            if self.in_misty():
                return self.hold_axis(opening=False)

        # 大招没好又没领域: 进濯雨时也只有底档延奏, 不如省下水云息, 攒协奏就走
        self.logger.info('suisui liberation not ready, quick pass')
        self.misty_start = -1
        self.build_concerto(self.QUICK_PASS_TIMEOUT, hold_e_forte=True)
        if not self.field_active() and self.cast_field():
            self.sleep(self.POST_LIB_SETTLE, check_combat=False)
        self.leave()

    def hold_axis(self, opening=False, skip_first_bar=False):
        """启动轴 / 循环轴。两条轴只有开头不同, 从"等第一格回路能量满"起完全一样。

        启动轴要自己攒水云息放醒春潮进濯雨时; 循环轴靠变奏技能进场时就已经在濯雨时里了。

        攻击键从头按到尾, 中间一次都不松: 等E、等第一格、切绯雪来回、等三格, 全是按住的
        状态。切人期间也按住 —— 点击落在谁身上就由谁打出来, 两边的输出都不断档。
        只在放 R 之前松手。

        【按住期间绝对不要再调 mouse_down()】—— 哪怕只是"补按一下保险"。
        PostMessage 后端的 mouse_down() 内部会走 update_mouse_pos() → try_activate(),
        每次都投一条 WM_ACTIVATE, 而窗口收到它就会把已经按住的状态打断。
        实测代价: 在切人循环里每发一次切人键补按一次攻击键, forte3 full after 从
        0.5 秒退化到 2 秒往上(切人那一秒多完全没输出); 撤掉之后两条轴都回到 0.5 秒。
        一次 mouse_down 就够了, 它会一直有效, 包括跨过切人 —— 绯雪出场那两下 A
        就是这么来的。

        Returns:
            None: 走到底一定会离场 (leave 里有兜底)。
        """
        axis = 'opening' if opening else 'loop'
        self.logger.info(f'suisui {axis} axis: hold attack -> E(land) -> +{self.E_LAND_TO_SWITCH}s '
                         f'-> dps touch -> Q -> forte3 -> R')
        axis_start = self.switch_in_anchor() if not opening else time.time()
        self.task.mouse_down()
        try:
            if opening:
                self.hold_until(self.e_ready, self.OPEN_E_WAIT_TIMEOUT, 'e ready')
                self.send_resonance_key()  # 醒春潮: 消耗水云息进濯雨时
                self.enter_misty_state()
                self.logger.info('suisui: xingchunchao cast, misty start')
                if not skip_first_bar:
                    # 启动轴: 从醒春潮放出那一刻算起
                    self.sleep(self.FIRST_BAR_TIME, check_combat=False)
                self.send_resonance_key()  # 按E落地
            elif not skip_first_bar:
                # 循环轴: 从【上场那一刻】算起的绝对时刻 —— FIRST_BAR_TIME_INTRO 是慢放
                # 量出来的"变奏入场 → 该按E"的间隔, 基准必须是上场
                target = axis_start + self.FIRST_BAR_TIME_INTRO
                self.sleep(max(0.0, target - time.time()), check_combat=False)
                self.send_resonance_key()  # 按E落地
                if self.E_LAND_SECOND > 0:
                    # 补一发盖住窗口另一侧, 见 E_LAND_SECOND
                    self.sleep(self.E_LAND_SECOND, check_combat=False)
                    self.send_resonance_key()
            else:
                self.send_resonance_key()  # 续打那条路: 第一格早满了, 直接按E落地
            self.sleep(self.E_LAND_TO_SWITCH, check_combat=False)

            if self.DPS_TOUCH and self.dps_touch() == 'out':
                # 【只在 'out' 这一种失败上补】: 没切过去 = 人还在空中、也还在自己身上,
                # 这时补一发E是安全的。平时不能盲补 —— 地面补E会把她重新顶上天
                # (E_LAND_SECOND 那次实验坐实过); 'back' 那种失败人已经在绯雪身上,
                # 发键就是发给绯雪, 更不能补
                self.logger.info('suisui: still airborne, re-sending E and retrying the touch')
                self.send_resonance_key()
                self.sleep(self.E_LAND_TO_SWITCH, check_combat=False)
                self.dps_touch()

            self.send_echo_key()  # Q
            self.sleep(self.BACK_TO_R, check_combat=False)
            self.wait_forte3()  # 保底: 三格回路能量满才准放R
        finally:
            self.task.mouse_up()

        cast = self.cast_field()
        if cast:
            self.sleep(self.POST_LIB_SETTLE, check_combat=False)
        else:
            self.logger.warning('suisui: liberation not ready at R time, leaving without field')
        self.leave(assume_intro=cast)

    def leave(self, assume_intro=False):
        """离场: 优先按数字键直接切洛瑟菈, 绕开 switch_next_char() 内部那一下多余的普攻。

        Args:
            assume_intro (bool): 直接认定协奏是满的。只有"刚放完 R"那条路能这么认 ——
                那时协奏基本一定满, 而能量环读数滞后会把 has_intro 误判成 False。
                过场模式没这个前提, 必须老老实实读, 否则洛瑟菈会以为自己带着变奏上场。
        """
        if self.DIRECT_SWITCH_AFTER_LIB \
                and self.direct_switch(assume_intro=assume_intro):
            return
        self.switch_next_char()

    def wait_forte3(self):
        """保底: 三格回路能量(芳菲信 600)没满就接着按住打, 满了立刻停手。

        延奏只有 600 档才给下一个角色 50% 攻击, 400 档只剩 12% 伤害提升 —— 这一格就是
        穗穗整套的全部价值, 空着手放 R 等于这一轮白站。所以这里宁可超时也要等。

        但等待有个物理上限: 濯雨时一关, 芳菲信【直接清零】, 再等下去永远等不到。
        所以窗口只剩 LIB_CAST_RESERVE 时就必须停手去放 R —— 那不是放弃保底,
        是继续等已经不可能成功了。

        Returns:
            bool: 三格是否真的满了。
        """
        start = time.time()
        while self.time_elapsed_accounting_for_freeze(start) < self.FORTE3_WAIT:
            if self.forte3_available():
                self.logger.info(f'suisui forte3 full after '
                                 f'{self.time_elapsed_accounting_for_freeze(start):.1f}s')
                return True
            left = self.misty_left()
            if 0 < self.misty_start and left <= self.LIB_CAST_RESERVE:
                self.logger.warning(f'suisui: misty closing ({left:.1f}s left) without forte3, '
                                    f'casting R now before the gauge wipes')
                return False
            self.sleep(self.FORTE3_POLL, check_combat=False)
        self.logger.warning(f'suisui forte3 still not full after {self.FORTE3_WAIT:.1f}s, '
                            f'casting R anyway')
        return False

    def switch_in_anchor(self):
        """循环轴的计时基准: 头像认出"切人完成"的那一刻。

        last_switch_in_time 是交接时 handoff_to() 写下的, 也就是 in_team() 从队伍头像上
        确认切换完成的时刻 —— 比"do_perform 被调用"早, 而且早多少是变化的:
        中间隔着框架的交接记账、上一个角色 leave() 的返回、任务循环再调到穗穗。
        那段变长的延迟正是 E 时机一直在飘、我们又看不见的部分。

        日志里那个 gap 就是它。gap 忽大忽小 = 锚对了; gap 每轮都差不多 = 方差另有来源。

        Returns:
            float: 用作计时基准的墙钟时刻。时间戳不可信时退回当前时刻。
        """
        now = time.time()
        anchored = self.last_switch_in_time
        gap = now - anchored if anchored > 0 else -1
        if 0 <= gap <= self.SWITCH_ANCHOR_MAX:
            self.logger.info(f'suisui: anchored on switch-in, {gap:.2f}s ago')
            return anchored
        self.logger.info(f'suisui: switch-in timestamp unusable (gap {gap:.2f}s), using now')
        return now

    def e_ready(self):
        """E 亮起来了没有 —— 两个信号取先亮的那个。

        `e_forte` 是框架通用的"E充满"标记; `suisui_e1` 是穗穗自己那张 E 技能格图标,
        上游 Suisui.try_e() 判"该按E了"用的就是它。之前只看 e_forte, 实战反馈第一个 E
        按晚了 —— 取"或"只可能让它更早, 不可能更晚, 所以这个改动没有下行风险。
        """
        return bool(self.is_e_forte_full()) or bool(self.task.find_one(Labels.suisui_e1))

    def hold_until(self, cond, timeout, name):
        """按住攻击键期间轮询某个条件。攻击键的按下/松开由调用方管。"""
        start = time.time()
        while self.time_elapsed_accounting_for_freeze(start) < timeout:
            if self.USE_F_BREAK:
                self.f_break()
            if cond():
                self.logger.info(f'suisui opening: {name} ready after '
                                 f'{self.time_elapsed_accounting_for_freeze(start):.1f}s')
                return True
            self.sleep(self.OPEN_POLL)
        self.logger.info(f'suisui opening: timed out waiting for {name} ({timeout:.1f}s)')
        return False

    def enter_misty(self):
        """浣尘时: 普攻 + E突进 攒【水云息】, 满了放「醒春潮」进濯雨时。"""
        start = time.time()
        while self.time_elapsed_accounting_for_freeze(start) < self.ENTER_MISTY_TIMEOUT:
            if self.USE_F_BREAK:
                self.f_break()
            if self.is_e_forte_full():
                # E 已变「醒春潮」: 放出去 = 进濯雨时 + 聚怪 + 挂霜渐 + 给全队润物(奶)
                if self.click_resonance(send_click=False, time_out=0, click_f=False)[0]:
                    self.logger.info('suisui xingchunchao cast, misty start')
                    self.enter_misty_state()
                    return
            elif self.resonance_available():
                self.click_resonance(send_click=False, time_out=0, click_f=False)  # 普通 E 突进, 回 40 点水云息
            self.continues_normal_attack(self.ATTACK_CHAIN_TIME, interval=self.ATTACK_INTERVAL)

        self.logger.warning('suisui failed to confirm misty entry, fall back to concerto build')
        self.misty_start = -1

    def enter_misty_state(self):
        self.misty_start = time.time()
        self._forte3_hits = 0

    def in_misty(self):
        return self.misty_start > 0 and self.misty_left() > self.LIB_CAST_RESERVE

    def misty_left(self):
        """濯雨时还剩多少秒。用墙钟: 这是游戏侧的 15 秒, 不能扣动画冻结时间。"""
        if self.misty_start <= 0:
            return -1
        return self.MISTY_WINDOW - (time.time() - self.misty_start)

    def dps_touch(self):
        """切绯雪入场, 到位之后立刻把场子要回来。

        要的只是"绯雪进场"这个事件本身, 不是让她打输出 —— 所以切过去之后一帧都不等,
        立刻开始发穗穗的键。回程可能撞上游戏的切人硬直, switch_to_index 会一直重发直到
        放行, 这就是"一直快速尝试切穗穗"。整个来回攻击键都是按住的。

        用数字键直接切, 不走 switch_next_char() —— 那个会按优先级挑目标, 而且会真的
        把 current_char 换掉, 一去不回。这里要的是"借用一下就还回来"。

        任何一步没切成都直接返回, 当这次没发生过 —— 框架状态没变, 后面的流程照常。

        Returns:
            str: 'ok'   —— 来回都成功;
                 'out'  —— 没切过去。几乎只有一个原因: 落地E没生效, 人还在空中。
                            这是【唯一】可以补一发E重试的情况 —— 人还在自己身上;
                 'back' —— 切过去了但没切回来。这时人在绯雪身上, 发任何键都是发给她的,
                            绝对不能补E;
                 'none' —— 队里没有主C。
        """
        dps = self.main_dps_teammate()
        if dps is None:
            return 'none'

        start = time.time()
        here = self.index
        self.logger.info(f'suisui: touch {dps.char_name} and come straight back')
        if not self.switch_to_index(dps.index, timeout=self.DPS_TOUCH_OUT_TIMEOUT):
            self.logger.info('suisui: failed to switch to dps, skip')
            return 'out'
        out_done = time.time()
        if not self.switch_to_index(here, timeout=self.DPS_TOUCH_BACK_TIMEOUT,
                                    resend=self.SWITCH_KEY_RESEND_BACK):
            self.logger.warning('suisui: failed to switch back from dps, '
                                'leave it to the framework')
            return 'back'
        # 来回两程分开记: 总时长两条轴一样(都是 1.3 秒), 想知道慢的是哪一程
        self.logger.info(f'suisui: dps touch done in {time.time() - start:.1f}s '
                         f'(out {out_done - start:.2f}s, back {time.time() - out_done:.2f}s)')
        return 'ok'

    def direct_switch(self, assume_intro=False):
        """按数字键直接切给交棒对象, 并按框架约定标记离场。

        不走 switch_next_char(): 那个函数内部会 continues_normal_attack / click,
        大招之后不想要那一下多余的A。
        """
        target = self.switch_target()
        if target is None or target is self:
            return False
        slot = target.index + 1
        # 刚放完 R 时直接认定协奏是满的 —— 读数滞后会把 has_intro 误判成 False,
        # 那样洛瑟菈就拿不到那 50% 攻击
        has_intro = True if assume_intro else self.wait_con_full()
        if not self.switch_to_index(target.index):
            self.logger.warning(f'suisui direct switch to slot {slot} failed')
            return False
        self.logger.info(f'suisui direct switched to slot {slot} (intro={has_intro})')
        self.handoff_to(target, has_intro)
        return True

    def handoff_to(self, target, has_intro):
        """把场上角色交接给 target —— 复刻 switch_next_char() 内部那套记账。

        直接按数字键切人绕开了框架的交接逻辑, 必须自己补上, 否则:
          - 没人的 is_current_char 是 True → get_current_char() 返回 None
            → AutoCombatTask.run() 里 None.perform() 直接崩掉;
          - 延奏/变奏的时间戳不更新, 下一个角色拿不到 has_intro。

        Args:
            target (BaseChar): 接场的角色。
            has_intro (bool): 离场时协奏是否满 —— 必须在【按切人键之前】读好。
                切走之后能量环显示的已经是新角色的了, 那时再读永远读不到自己的协奏。
        """
        self.task.in_liberation = False
        self.switch_out(con_full=has_intro)
        target.is_current_char = True
        # 这一行是框架 _choose_switch_target() 里设的, 直接切人绕开了它必须自己补 ——
        # 漏了它接场角色的 has_intro 永远是 False, 穗穗就会以为自己空手入场,
        # 跑去走开场那套"按住攻击键"的流程(表现就是切过去一直在蓄力重击)
        target.has_intro = has_intro
        if has_intro and hasattr(target, 'note_intro_handoff'):
            # has_intro 是易失的: reset_state() 每次重读队伍都会清掉它, 而战斗判定一抖动
            # 就会重进战斗、重读队伍。所以再给对方打一个它自己保管的持久标记
            target.note_intro_handoff()
        target.last_switch_in_time = time.time()
        if has_intro:
            now = time.time()
            self.task.add_freeze_duration(now, target.intro_motion_freeze_duration, -100)
            self.last_outro_time = now

    def wait_con_full(self):
        """短暂轮询协奏是否满 —— 用来决定交接时给不给对方变奏。

        不能只读一次: 放完大招那一刻协奏其实已经满了, 但能量环读数滞后, 读成 0 就会把
        has_intro 判成 False, 下一个角色拿不到变奏(表现就是"切过去没有协奏")。
        框架的 switch_next_char() 是在循环里反复读的, 天然有等待; 直接切人必须自己补上。
        """
        start = time.time()
        while time.time() - start < self.HANDOFF_CON_WAIT:
            if self.is_con_full():
                return True
            self.sleep(self.HANDOFF_CON_POLL, check_combat=False)
        self.logger.info('suisui: con not full before switch, next char gets no intro')
        return False

    def switch_target(self):
        """交棒对象: 先按角色名找, 找不到再退回写死的槽位。

        按名字找是为了不假设队伍顺序 —— 别人的队里洛瑟菈未必在 2 号位。
        本队两条路指向同一个人, 所以这层是纯增量, 不改变现有行为;
        名字也找不到、槽位也取不到时返回 None, 调用方会退回框架的 switch_next_char()。
        """
        for char in self.task.chars:
            if char is not None and char is not self and char.char_name == self.SWITCH_TARGET_NAME:
                return char
        return self.char_at_slot(self.DIRECT_SWITCH_INDEX)

    def char_at_slot(self, slot):
        """按队伍位置 (1-based) 取角色, 越界返回 None。"""
        index = slot - 1
        for char in self.task.chars:
            if char is not None and char.index == index:
                return char
        return None

    def switch_to_index(self, index, timeout=None, resend=None):
        """按数字键切到指定队伍位置, 重发到 in_team 确认切过去了为止。

        【轮询快、重发慢】: 这两件事以前共用一个 0.12 秒的节奏, 于是切换已经生效、
        但 in_team() 还没反映出来的那两三帧里, 又多发了两三次同一个键。那些多余的键
        排在队里, 会在我们已经切回穗穗之后再触发一次 —— 表现就是"绯雪在错误的节点
        又切进来了"。现在轮询保持 0.05 秒(尽快发现切成了), 重发拉到 SWITCH_KEY_RESEND。

        不管攻击键 —— 调用方(hold_axis)全程按住, 这里不该动它。

        Returns:
            bool: 是否切到了。
        """
        timeout = self.DPS_TOUCH_OUT_TIMEOUT if timeout is None else timeout
        resend = self.SWITCH_KEY_RESEND if resend is None else resend
        start = time.time()
        last_send = 0.0
        while time.time() - start < timeout:
            in_team, current_index, _ = self.task.in_team()
            if in_team and current_index == index:
                return True
            if time.time() - last_send >= resend:
                self.task.send_key(index + 1)
                last_send = time.time()
            self.sleep(self.SWITCH_POLL, check_combat=False)
        return False

    def build_concerto(self, timeout, hold_e_forte=False):
        """单纯攒协奏: 至少把延奏底档的 25% 全伤加深带出去, 别空手离场。

        Args:
            timeout (float): 最长尝试时间。
            hold_e_forte (bool): True 时不放已充能的 E —— 过场模式把水云息留到下一轮,
                下一轮才能在大招好的时候进濯雨时。
        """
        # 先等读数稳定: 大招刚放完时协奏往往已经满了, 只是能量环还没渲染回来
        settle = time.time()
        while time.time() - settle < self.CON_SETTLE_WAIT:
            if self.is_con_full():
                return True
            self.sleep(self.CON_SETTLE_POLL)

        start = time.time()
        while self.time_elapsed_accounting_for_freeze(start) < timeout:
            if self.is_con_full():
                return True
            if self.USE_F_BREAK:
                self.f_break()
            if self.resonance_available() and not (hold_e_forte and self.is_e_forte_full()):
                self.click_resonance(send_click=False, time_out=0, click_f=False)
                continue
            if self.echo_available():
                self.click_echo(time_out=0)
            self.continues_normal_attack(self.CON_TOP_UP_CHAIN, interval=self.ATTACK_INTERVAL,
                                         until_con_full=True)

        self.logger.warning('suisui concerto build timed out, switching without full outro')
        return False

    # ------------------------------------------------------------------ 技能 / 状态

    def cast_field(self):
        """共鸣解放「山河水境」: 30 秒领域, 效应上限+3, 放完紧接着延奏进仙游碧落。"""
        if not self.liberation_available():
            return False
        # click_f=False: 这个参数默认是 True, 意思是"大招动画期间每 0.1 秒发一次 F"。
        # 她的 R 动画 4.3 秒, 等于替全队按掉四十来次处决 —— 绯雪轴上那个 F 位就是被
        # 这些自动 F 提前吃掉的。全队的处决只归绯雪的 macro_execute() 管
        if self.click_liberation(wait_if_cd_ready=0.3, click_f=False):
            self.last_field = time.time()
            self.logger.info('suisui field deployed')
            return True
        return False

    def field_active(self):
        """山河水境是否还在(按时间推算, 领域没有可靠识别图)。"""
        return self.last_field > 0 and time.time() - self.last_field < self.FIELD_ACTIVE_TIME

    def worth_full_rotation(self):
        """值不值得花时间进濯雨时: 大招好了 / 快好了 / 上一轮领域还在, 才走完整套。"""
        return (self.liberation_available()
                or self.task.get_cd('liberation') <= self.LIB_CD_TOLERANCE
                or self.field_active())

    def forte3_available(self):
        """【芳菲信】是否满 600 (延奏最高档)。

        两道保险, 都是为了防止误判导致提前开 R:
          1. 连续命中 FORTE3_CONFIRM 次才认 —— 单帧误判不算数;
          2. 刚进濯雨时不足 MIN_MISTY_BEFORE_LIB 秒时直接判否 ——
             芳菲信上限 600, 刚进去物理上不可能满, 这时的命中一定是误判。
        """
        if 0 < self.misty_start and (time.time() - self.misty_start) < self.MIN_MISTY_BEFORE_LIB:
            return False
        if not self.task.find_one(Labels.suisui_forte3, threshold=self.FORTE3_THRESHOLD):
            self._forte3_hits = 0
            return False
        self._forte3_hits += 1
        return self._forte3_hits >= self.FORTE3_CONFIRM

    # ------------------------------------------------------------------ 切人

    def switch_out(self, con_full=False):
        if con_full or self.current_con == 1:
            self.last_outro = time.time()  # 只有协奏满离场才真的放出了延奏
            self.misty_start = -1  # 延奏会退出濯雨时
        super().switch_out(con_full=con_full)

    def note_intro_handoff(self):
        """被别人用直接切人的方式交接进场时调用 —— 记下"我是带着变奏上来的"。"""
        self.intro_pending = True

    def on_combat_end(self, chars):
        # 只清和"当前这场战斗的状态", 不清 last_outro / last_field 这类时间戳:
        # 时间戳自己会过期, 主动清零反而会让锁定期失效。
        # 也不要把这些放进 reset_state(): 那个钩子每次重新识别队伍都会触发,
        # 会在战斗中途把濯雨时的计时和锁定期一起抹掉。
        self.misty_start = -1

    def get_switch_priority(self, current_char=None, has_intro=False, target_low_con=False):
        main_dps = self.main_dps_teammate()

        lockout = self.MAIN_DPS_OUTRO_LOCKOUT if main_dps else self.OUTRO_LOCKOUT
        if self.time_elapsed_accounting_for_freeze(self.last_outro) < lockout \
                and self.has_other_candidate(current_char):
            return SwitchPriority.NO

        if main_dps is not None:
            # 队里有主C: 只接主C的延奏(闭环起新一轮)。
            # 要求 has_intro 是有意的 —— 她的变奏技能本身就把她推进濯雨时,
            # 没有变奏的入场要先花 4~6 秒攒水云息, 亏得多。
            # 其他所有情况让位, 尤其是洛瑟菈那一棒: 她的延奏是留给主C的。
            if current_char is not None and current_char.is_main_dps and has_intro:
                return SwitchPriority.MUST
            if self.has_other_candidate(current_char):
                return SwitchPriority.NO
        return SwitchPriority.MUST

    def main_dps_teammate(self):
        """队里除自己以外的主C, 没有则 None。"""
        return next((char for char in self.task.chars
                     if char is not None and char is not self and char.is_main_dps), None)

    def has_other_candidate(self, current_char):
        """返回 NO 之前确认还有别人能上, 否则切人逻辑会卡在原地空转。"""
        return any(char is not None and char is not self and char is not current_char
                   for char in self.task.chars)
